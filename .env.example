# AgentOctopus Local Environment Configuration Example
# Copy to `.env` in the workspace root (`.env` is gitignored; NEVER write to OS PATH/registry).

# Dedicated loopback-only Seq2Seq NMT container (started via scripts/start_local_nmt.ps1 or .sh)
# Strictly loopback (`127.0.0.1`, `localhost`, or `[::1]`) — cloud URLs are rejected fail-closed.
OCTOPUS_TRANSLATE_URL=http://127.0.0.1:5050/translate

# Fast NMT health probe timeout (ms, strict 100..=400ms anti-hang law)
OCTOPUS_NMT_PROBE_TIMEOUT_MS=400

# Seq2Seq CPU translation inference timeout (ms, 250..=10000ms)
OCTOPUS_NMT_TIMEOUT_MS=2500

# Workload preset: balanced | strict_defense | code_heavy_dev | multilingual_research
OCTOPUS_PPL_PRESET=balanced

# Optional fine-grained threshold overrides (validated against safe security bounds)
# OCTOPUS_PPL_GCG_THRESHOLD=12.5
# OCTOPUS_PPL_CLIFF_PPL_THRESHOLD=10.5
# OCTOPUS_PPL_CLIFF_RATIO=1.45
# OCTOPUS_PPL_JITTER_THRESHOLD=0.36
# OCTOPUS_PPL_ACTION_SURPRISAL_BITS=7.2
# OCTOPUS_PPL_ACTION_SEQ_LIMIT=28.0
# OCTOPUS_PPL_SEMANTIC_ENTROPY_BITS=0.95
