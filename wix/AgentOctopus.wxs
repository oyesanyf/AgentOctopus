<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package Name="Agent Octopus"
             Manufacturer="Agent Octopus Security"
             Version="0.1.0.0"
             UpgradeCode="7a8b9c0d-1e2f-4a3b-8c9d-0e1f2a3b4c5d"
             Scope="perUser"
             Compressed="yes">

        <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <StandardDirectory Id="LocalAppDataFolder">
            <Directory Id="INSTALLFOLDER" Name="AgentOctopus">
                <Component Id="CoreExecutables" Guid="3a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d" Bitness="always64">
                    <File Id="StartLauncherExe" Source="target\release\start.exe" KeyPath="yes" />
                    <File Id="AgentOctopusCliExe" Source="target\release\agent_octopus.exe" />
                    <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
                </Component>
                <Directory Id="ConfigDir" Name="config">
                    <Component Id="DefaultConfigFiles" Guid="8b4f912c-3b18-4e89-9a2c-f67e2a96f122" Bitness="always64">
                        <File Id="EgressDomainsConfig" Source="config\egress_domains.json" KeyPath="yes" />
                        <RemoveFolder Id="RemoveConfigFolder" Directory="ConfigDir" On="uninstall" />
                        <RegistryValue Root="HKCU" Key="Software\AgentOctopus" Name="ConfigInstalled" Type="integer" Value="1" />
                    </Component>
                </Directory>
            </Directory>
        </StandardDirectory>

        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="ApplicationProgramsFolder" Name="Agent Octopus">
                <Component Id="StartMenuShortcutComponent" Guid="5f2e8694-5ef8-4903-b1da-5847fa2c03d1">
                    <Shortcut Id="ApplicationStartMenuShortcut"
                              Name="Agent Octopus Dashboard"
                              Description="Launch Agent Octopus Zero-Trust Wasm &amp; AgentMesh Gateway"
                              Target="[INSTALLFOLDER]start.exe"
                              WorkingDirectory="INSTALLFOLDER" />
                    <RemoveFolder Id="RemoveShortcutFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
                    <RegistryValue Root="HKCU" Key="Software\AgentOctopus" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
                </Component>
            </Directory>
        </StandardDirectory>

        <Feature Id="MainFeature" Title="Agent Octopus Core Runtime" Level="1">
            <ComponentRef Id="CoreExecutables" />
            <ComponentRef Id="DefaultConfigFiles" />
            <ComponentRef Id="StartMenuShortcutComponent" />
        </Feature>
    </Package>
</Wix>
